// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  uid          String   @id @default(cuid())
  firstname    String
  lastname     String?
  email        String   @unique
  passwordHash String   @map("password_hash")
  classes      Class[]

  @@map("teacher")
}

model Student {
  uid        String              @id @default(cuid())
  firstname  String
  lastname   String?
  email      String             @unique
  passwordHash String            @map("password_hash")
  classid    String                @default("1")
  totalTime  Int                 @default(0)  @map("total_time") //seconds
  gender     String?
  dateOfBirth BigInt?            @map("date_of_birth")
  class      Class               @relation(fields: [classid], references: [id])
  testStatuses StudentTestStatus[]
  studentLessons StudentLesson[]

  @@map("student")
}

model Class {
  id         String        @id @default(cuid()) // PRIMARY KEY ("id")
  className  String      @map("class_name")
  teacherid  String
  teacher    Teacher     @relation(fields: [teacherid], references: [uid])
  students   Student[]
  classTests ClassTest[]
  lessons    ClassLesson[]

  @@map("class")
}

model Lesson {
  id          String           @id @default(cuid())
  name        String
  type        Int
  description String
  content     Json          @default("{}")
  difficulty  Int
  dateCreated BigInt           @map("date_created")
  classes     ClassLesson[]
  students    StudentLesson[]

  @@map("lesson")
}

model Test {
  id              String                 @id @default(cuid())
  name            String
  dateCreated     BigInt                 @map("date_created")
  timeLimit       Int                 @map("time_limit")
  allowedAttempts Int                 @map("allowed_attempts")
  difficulty      Int
  questions       Question[]
  classTests      ClassTest[]
  studentStatuses StudentTestStatus[]

  @@map("test")
}

model Question {
  id               String           @id @default(cuid())
  question         String
  answer           String
  isMultipleChoice Int             @map("is_multiple_choice")
  choices          Json         
  testid           String
  test             Test            @relation(fields: [testid], references: [id])
  studentAnswers   StudentAnswer[]

  @@map("question")
}

model StudentLesson {
  studentid    String         
  lessonid     String
  results      Json
  student      Student         @relation(fields: [studentid], references: [uid])
  lesson       Lesson          @relation(fields: [lessonid], references: [id])

  @@id([studentid, lessonid])
  @@map("student_lesson")
}

model StudentTestStatus {
  studentid    String
  testid       String
  dateCreated  BigInt             @map("date_created")
  dateFinished BigInt             @map("date_finished")
  duration     Int
  result       Float           
  student      Student         @relation(fields: [studentid], references: [uid])
  test         Test            @relation(fields: [testid], references: [id])
  answers      StudentAnswer[]

  // 1. Define the compound primary key here
  @@id([studentid, testid, dateCreated]) 
  @@map("student_test_status")
}

model StudentAnswer {
  studentid  String          // 2. Added to match the new parent identity
  testid     String            // 2. Added to match the new parent identity
  dateCreated BigInt         @map("date_created")    // 2. Added to match the new parent identity
  questionid String
  answer     String?
  question   Question        @relation(fields: [questionid], references: [id])
  
  // 3. Update the relation fields and references to map to the composite key
  session    StudentTestStatus @relation(fields: [studentid, testid, dateCreated], references: [studentid, testid, dateCreated])

  // 4. Update your primary key combination for the answers table
  @@id([studentid, testid, dateCreated, questionid]) 
  @@map("student_answer")
}

// Many-to-Many Join Tables mapped explicitly from your schema constraints
model ClassLesson {
  classid  String
  lessonid String
  class    Class  @relation(fields: [classid], references: [id])
  lesson   Lesson @relation(fields: [lessonid], references: [id])

  @@id([classid, lessonid])
  @@map("class_lesson")
}

model ClassTest {
  classid String
  testid  String
  class   Class @relation(fields: [classid], references: [id])
  test    Test  @relation(fields: [testid], references: [id])

  @@id([testid, classid])
  @@map("class_test")
}

model DictionaryEntry {
  id        String     @id @default(cuid())
  word      String
  description String
  imageName String  @map("image_name")

  @@map("dictionary_entry")
}

model SystemConfig {
  key String @id
  value String

  @@map("system_config")
}